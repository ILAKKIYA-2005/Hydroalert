# ========================================================
# HydroAlert Backend Environment Template (.env.example)
# Rename to .env and configure for your local or cloud environment.
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING PRODUCTION SECRETS.
# ========================================================

# Server Port
PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/hydroalert_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_mysql_password_here

# JWT Secret Key (Generate a random 32+ character string for production)
JWT_SECRET=your_custom_secure_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs of React frontends)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JPA Settings (update or validate)
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=false

# HydroAlert Leakage Detection Threshold (L/min)
LEAKAGE_THRESHOLD=8.0
